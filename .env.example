# Copy to repository-root .env locally; never paste actual values into chat.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Phase 9 (required in production, optional to protect local development).
# Random 32–128 character backend-only shared password. Never use VITE_*.
DEMO_ACCESS_KEY=
# Single-process attempt caps. Restart resets counters; these are NOT a billing quota.
DEMO_API_PER_MINUTE=300
DEMO_WRITES_PER_MINUTE=20
DEMO_UPLOADS_PER_HOUR=5
DEMO_MODEL_CALLS=100
DEMO_EMBEDDING_CALLS=200
DEMO_SEARCH_CALLS=20
# Empty means not configured. Never place this in VITE_* variables.
DATABASE_URL=
# Supabase Direct or Session pooler URI from Connect panel, no query parameters.
# Percent-encode ONLY the password once. Do not use anon/service_role API keys.
# Require certificate verification for hosted databases; false for local Postgres.
DATABASE_SSL=true
# Official public Supabase CA is bundled by build. Railway absolute path:
# /app/dist/server/certs/prod-ca-2021.crt (local paths may differ).
DATABASE_CA_CERT=
# Backend-only OpenAI-compatible endpoint; include /v1 if required by provider.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=1024
# Meeting structured analysis has a separate output allowance; ordinary chat unchanged.
MEETING_MAX_TOKENS=8192
MEETING_TIMEOUT_MS=90000
# Phase 3: existing PRIVATE bucket only; keys remain backend-only.
SUPABASE_URL=
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=
# Separate OpenAI-compatible Embedding API (not the DeepSeek chat API).
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# Cosine threshold depends on selected model; calibrate on acceptance fixtures.
RAG_MIN_SIMILARITY=0.5
# Only affects the local Vite proxy (restart dev server after changing).
API_PROXY_TARGET=http://127.0.0.1:3001

# Phase 6: backend-only email. Keep disabled until explicit real-send approval.
EMAIL_DELIVERY_ENABLED=false
EMAIL_SCOPE=demo
RESEND_API_KEY=
# Plain mailbox only, e.g. onboarding@resend.dev for restricted account-owner testing.
EMAIL_FROM=
# Exact comma-separated demo recipient allowlist, never wildcard/domains.
EMAIL_ALLOWED_RECIPIENTS=
# test: only onboarding@resend.dev -> Resend account owner's email.
# verified: requires a verified matching domain and domain/read permissions.
EMAIL_MODE=test
EMAIL_TEST_ACCOUNT_ADDRESS=
RESEND_DOMAIN_ID=

# Phase 7 backend only; placeholder, never configure VITE_* keys.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT_MS=10000
SEARCH_MAX_RESULTS=5
# Attempt cap per API process (including failed requests); restart resets it.
SEARCH_MAX_CALLS=20

# Legacy local secret: when DEMO_ACCESS_KEY is absent, reuse this for ONE full-site Demo login.
# Explicit DEMO_ACCESS_KEY takes precedence. Production still requires DEMO_ACCESS_KEY.
# If used, random 32–128 characters server-side; never VITE_* or source control.
PPT_ACCESS_KEY=
PPT_SCOPE=demo
PPT_MAX_TOKENS=8192
